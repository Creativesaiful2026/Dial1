<?xml version="1.0" encoding="utf-8"?>
<!-- DialMe is offline-first: call notes, private vault, block lists and settings
     must never leave the device through cloud backup. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
